{
  "name": "finance-learning-hub",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "corepack pnpm --filter @finance/web dev",
    "build": "corepack pnpm --filter @finance/web build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "corepack pnpm -r --if-present typecheck && tsc --noEmit -p scripts/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify:deployment": "tsx scripts/verify-deployment.ts",
    "check": "corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test && corepack pnpm build",
    "db:migrate": "corepack pnpm --filter @finance/db migrate",
    "db:configure-app-role": "corepack pnpm --filter @finance/db configure-app-role",
    "db:seed": "corepack pnpm --filter @finance/db seed",
    "ingest": "corepack pnpm --filter @finance/ingest ingest",
    "content:scan": "corepack pnpm --filter @finance/ingest content:scan",
    "content:extract": "corepack pnpm --filter @finance/ingest content:extract",
    "content:pair": "corepack pnpm --filter @finance/ingest content:pair",
    "content:validate": "corepack pnpm --filter @finance/ingest content:validate",
    "content:generate": "corepack pnpm --filter @finance/content-generation content:generate",
    "content:validate-generated": "corepack pnpm --filter @finance/content-generation content:validate-generated",
    "content:report": "corepack pnpm --filter @finance/content-generation content:report"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@playwright/test": "^1.62.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.30.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.0"
  }
}
