# Copy to `.env` (git-ignored). Every value below is optional: with no `.env`
# at all the app boots on seeded data. Validation lives in apps/web/lib/env.ts
# and rejects contradictory combinations (see the notes on each block).

# --- App ---------------------------------------------------------------------
# Canonical absolute URL. Defaults to the Vercel preview URL, then localhost.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Finance Learning Hub

# --- Database ----------------------------------------------------------------
# FINANCE_HUB_USE_DATABASE=true REQUIRES DATABASE_URL, otherwise boot fails
# instead of silently falling back to seeded data.
FINANCE_HUB_USE_DATABASE=false
DATABASE_URL=postgresql://finance:finance_dev_password@localhost:5432/finance_hub

# --- Public demo safeguard ---------------------------------------------------
# When true, all write routes (uploads, imports, attempts, exams, revisions)
# answer 403 and the matching UI controls render disabled with an explanation.
# Also implied by VERCEL_ENV=production while LEARNING_HUB_AUTH_ENABLED=false.
FINANCE_HUB_PUBLIC_DEMO=false

# --- Auth (HTTP basic, handled in apps/web/proxy.ts) -------------------------
# LEARNING_HUB_AUTH_ENABLED=true REQUIRES both user and password.
LEARNING_HUB_AUTH_ENABLED=false
LEARNING_HUB_AUTH_USER=ludo
LEARNING_HUB_AUTH_PASSWORD=change_me_locally

# --- AI provider -------------------------------------------------------------
# Accepted values: none | openai | ollama. Only these are implemented in
# packages/ai; any other value is rejected rather than silently disabling AI.
# AI_PROVIDER=openai REQUIRES OPENAI_API_KEY.
AI_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- End-to-end tests --------------------------------------------------------
# Optional. Point Playwright at an already-running server instead of booting one.
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
