# Copy to `.env` (git-ignored). Every value below is optional: with no `.env`
# at all the app boots on seeded data. Validation lives in apps/web/lib/env.ts
# and rejects contradictory combinations (see the notes on each block).

# --- App ---------------------------------------------------------------------
# Canonical absolute URL. Defaults to the Vercel preview URL, then localhost.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Finance Learning Hub

# --- Database ----------------------------------------------------------------
# FINANCE_HUB_USE_DATABASE=true REQUIRES DATABASE_URL, otherwise boot fails
# instead of silently falling back to seeded data. This is the constrained
# runtime role; create it once with `pnpm db:configure-app-role`.
FINANCE_HUB_USE_DATABASE=false
DATABASE_URL=postgresql://finance_app:finance_app_dev_password@localhost:5432/finance_hub
# Used only by migrations and seeds. Never expose it to the web app.
DATABASE_ADMIN_URL=postgresql://finance:finance_dev_password@localhost:5432/finance_hub

# --- Public demo safeguard ---------------------------------------------------
# When true, all write routes (uploads, imports, attempts, exams, revisions)
# answer 403 and the matching UI controls render disabled with an explanation.
# Also implied by VERCEL_ENV=production while LEARNING_HUB_AUTH_ENABLED=false.
FINANCE_HUB_PUBLIC_DEMO=false

# --- Accounts ----------------------------------------------------------------
# Turns on real user accounts: signup, login, per-user ownership and PostgreSQL
# row level security. REQUIRES FINANCE_HUB_USE_DATABASE=true, since accounts and
# sessions are rows.
#
# LEARNING_HUB_AUTH_USER / LEARNING_HUB_AUTH_PASSWORD were the old shared HTTP
# basic credential. They were retired in PR-01 and are now REJECTED at boot
# rather than ignored, so a stale .env cannot leave you thinking the app is gated.
LEARNING_HUB_AUTH_ENABLED=false

# --- AI provider -------------------------------------------------------------
# Accepted values: none | openai | ollama. Only these are implemented in
# packages/ai; any other value is rejected rather than silently disabling AI.
# AI_PROVIDER=openai REQUIRES OPENAI_API_KEY.
AI_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Stripe billing (PR-07) --------------------------------------------------
# The flag is the rollback lever. With it false — the default — nothing is gated:
# the Excel lab and the attestations are open, and /billing says payment is off.
# Turning it TRUE REQUIRES LEARNING_HUB_AUTH_ENABLED=true (and therefore a
# database), STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET and at least one price id.
# An entitlement is a row owned by an account; selling access with nowhere to
# record it would take the money and grant nothing, so boot fails instead.
FINANCE_HUB_BILLING_ENABLED=false

# Server only. Rejected at boot if it starts with pk_, and a live key (sk_live_)
# is rejected outside production so a test webhook secret cannot silently pair
# with live traffic.
STRIPE_SECRET_KEY=
# Server only. The whsec_… printed by `stripe listen`, or shown on the endpoint
# page in the dashboard. Each endpoint has its own: the local CLI secret and the
# deployed one are different values.
STRIPE_WEBHOOK_SECRET=
# The only Stripe value that may reach a browser. Optional: this integration
# redirects to Stripe-hosted Checkout and does not mount Stripe.js.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Server only, and deliberately never NEXT_PUBLIC_. A client that can name a
# price can name a cheaper one; the checkout route resolves the id from the plan
# key it is sent. At least one of the two is required when billing is on.
STRIPE_PRICE_FOUNDER_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=

# --- Tests -------------------------------------------------------------------
# Optional. Point Playwright at an already-running server instead of booting one.
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
#
# Enables the database-backed Playwright project that exercises the real auth
# flow (signup, protected route, per-user isolation).
# PLAYWRIGHT_AUTH_DATABASE_URL=postgresql://finance_app:finance_app_dev_password@localhost:5432/finance_hub
#
# Enables the row-level-security isolation tests in packages/db/test. Without it
# they SKIP, and the suite prints a warning saying isolation was not verified.
# RLS_TEST_DATABASE_URL=postgresql://finance_app:finance_app_dev_password@localhost:5432/finance_hub
# RLS_TEST_ADMIN_DATABASE_URL=postgresql://finance:finance_dev_password@localhost:5432/finance_hub
